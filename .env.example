# Shopify Storefront API (público, solo lectura de catálogo + carrito)
SHOPIFY_STORE_DOMAIN=bb8s0y-gr.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07

# Secreto para /api/revalidate (webhooks de Shopify -> revalidación ISR)
SHOPIFY_REVALIDATION_SECRET=

# URL pública del sitio (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://br.example.com

# Briefs de "Personaliza" y "Marcas": se reenvían a este webhook (Make, Zapier, n8n, Slack...)
BRIEF_WEBHOOK_URL=

# WhatsApp de atención (formato internacional sin +), opcional
NEXT_PUBLIC_WHATSAPP=
