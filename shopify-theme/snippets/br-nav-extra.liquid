{%- doc -%}
  Respaldo del menú principal: añade «Diseña tu prenda» e «Impulsa tu marca» si el menú
  de Shopify (Contenido > Menús) no los incluye. Si ya están en el menú, no hace nada.

  @param {object} linklist - El menú que se está pintando
  @param {string} variant - 'menu' (escritorio), 'bar' (barra móvil), 'drawer' (cajón móvil) o 'styles'
  @param {number} [animation_index] - Índice de animación del cajón
{%- enddoc -%}
{%- if variant == 'styles' -%}
  <style>
    /* Apartado activo bien visible (escritorio y móvil) */
    .menu-list__link--active .menu-list__link-title,
    .menu-list__link[aria-current='page'] .menu-list__link-title {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
    .menu-drawer__menu-item[aria-current='page'],
    .menu-list--mobile a[aria-current='page'] {
      font-weight: 700;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 5px;
    }
  </style>
{%- else -%}
  {%- assign extras = 'disena-tu-prenda|Diseña tu prenda,impulsa-tu-marca|Impulsa tu marca' | split: ',' -%}
  {%- assign idx = animation_index | default: 0 -%}
  {%- for item in extras -%}
    {%- liquid
      assign parts = item | split: '|'
      assign handle = parts[0]
      assign pagina = pages[handle]
      if pagina == empty or pagina == blank
        continue
      endif
      assign ya_en_menu = false
      for l in linklist.links
        if l.url == pagina.url or l.url contains handle
          assign ya_en_menu = true
        endif
      endfor
      if ya_en_menu
        continue
      endif
      assign activo = false
      if request.path == pagina.url or request.page_type == 'page' and page.handle == handle
        assign activo = true
      endif
      assign idx = idx | plus: 1
    -%}
    {%- case variant -%}
      {%- when 'drawer' -%}
        <li
          style="--menu-drawer-animation-index: {{ idx }};"
          class="menu-drawer__list-item--flat"
        >
          <a
            href="{{ pagina.url }}"
            class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
            {% if activo %}aria-current="page"{% endif %}
          >
            <span class="menu-drawer__menu-item-text wrap-text">{{ parts[1] }}</span>
          </a>
        </li>
      {%- when 'bar' -%}
        <li>
          <a href="{{ pagina.url }}" class="menu-list__item" {% if activo %}aria-current="page"{% endif %}>{{ parts[1] }}</a>
        </li>
      {%- else -%}
        <li
          class="menu-list__list-item"
          on:blur="/deactivate"
          on:pointerenter="/activate"
          on:pointerleave="/deactivate"
        >
          <a
            href="{{ pagina.url }}"
            data-skip-node-update="true"
            class="menu-list__link{% if activo %} menu-list__link--active{% endif %}"
            {% if activo %}aria-current="page"{% endif %}
            ref="menuitem"
          >
            <span class="menu-list__link-title">{{ parts[1] }}</span>
          </a>
        </li>
    {%- endcase -%}
  {%- endfor -%}
{%- endif -%}
