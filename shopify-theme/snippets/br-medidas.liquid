{%- doc -%}
  ÚNICA FUENTE de la tabla de medidas de BR (ficha de producto y «Diseña tu prenda»).

  Para cambiar las medidas, edita `medidas` (talla,largo,pecho,bajo relajado,manga en cm,
  prenda plana; tallas separadas por «;»).
  La imagen es solo el dibujo de cómo se mide (assets/br-guia-medidas.webp, recortado de la
  tabla de medidas): las cifras van en la tabla HTML para no duplicarlas. Para quitarla, pon
  `mostrar_imagen` a false.

  @param {string} [formato] - 'tabla' (por defecto, HTML) o 'json' (para el estudio 3D)
{%- enddoc -%}
{%- liquid
  assign medidas = 'XS,58,61,34,55;S,61,63,36,57;M,64,65,38,59;L,67,67,40,61;XL,70,70,42,63;XXL,73,73,44,65'
  assign imagen = 'br-guia-medidas.webp'
  assign mostrar_imagen = true
  assign nota = 'Medidas de la prenda en plano, en cm. Corte boxy y corto: si prefieres más holgura, elige una talla más.'
  assign filas = medidas | split: ';'
-%}

{%- if formato == 'json' -%}
{"nota": {{ nota | json }}, "imagen": {% if mostrar_imagen %}{{ imagen | asset_url | json }}{% else %}null{% endif %}, "filas": [
  {%- for fila in filas -%}
    {%- assign c = fila | split: ',' -%}
    {"talla": {{ c[0] | strip | json }}, "largo": {{ c[1] | strip | plus: 0 }}, "pecho": {{ c[2] | strip | plus: 0 }}, "bajo": {{ c[3] | strip | plus: 0 }}, "manga": {{ c[4] | strip | plus: 0 }}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]}
{%- else -%}
  <div class="br-medidas">
    <div class="br-medidas__scroll" role="region" aria-label="Tabla de medidas" tabindex="0">
      <table class="br-medidas__tabla">
        <thead>
          <tr><th scope="col">Talla</th><th scope="col">Largo total</th><th scope="col">Ancho pecho</th><th scope="col">Bajo relajado</th><th scope="col">Largo manga</th></tr>
        </thead>
        <tbody>
          {%- for fila in filas -%}
            {%- assign c = fila | split: ',' -%}
            <tr><th scope="row">{{ c[0] | strip }}</th><td>{{ c[1] | strip }}</td><td>{{ c[2] | strip }}</td><td>{{ c[3] | strip }}</td><td>{{ c[4] | strip }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    <p class="br-medidas__nota">{{ nota }}</p>
    {%- if mostrar_imagen -%}
      <figure class="br-medidas__figura">
        <a class="br-medidas__imagen" href="{{ imagen | asset_url }}" target="_blank" rel="noopener" aria-label="Ampliar el dibujo de cómo se mide">
          <img src="{{ imagen | asset_url }}" alt="Cómo se mide: largo total desde el hombro junto a la capucha hasta el bajo, ancho de pecho de axila a axila, bajo relajado y largo de manga desde la costura del hombro" loading="lazy" width="992" height="1016">
          <span>Toca para ampliar</span>
        </a>
        <figcaption>Cómo medimos (prenda en plano): Total length = largo total · Chest width = ancho pecho · Bottom relaxed = bajo relajado · Sleeve length = largo manga.</figcaption>
      </figure>
    {%- endif -%}
  </div>
  <style>
    .br-medidas { display: grid; gap: 10px; font-size: 14px; }
    .br-medidas__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid rgb(var(--color-foreground-rgb, 23 20 18) / 0.12); border-radius: 12px; }
    .br-medidas__tabla { width: 100%; min-width: 360px; border-collapse: collapse; text-align: center; font-variant-numeric: tabular-nums; }
    .br-medidas__tabla th, .br-medidas__tabla td { padding: 10px 8px; border-bottom: 1px solid rgb(var(--color-foreground-rgb, 23 20 18) / 0.08); }
    .br-medidas__tabla thead th { font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .br-medidas__tabla tbody th { font-weight: 700; }
    .br-medidas__tabla tbody tr:last-child > * { border-bottom: 0; }
    .br-medidas__nota { margin: 0; font-size: 13px; opacity: .75; }
    .br-medidas__figura { margin: 0; display: grid; gap: 6px; max-width: 360px; }
    .br-medidas__figura figcaption { font-size: 12px; opacity: .7; }
    .br-medidas__imagen { display: block; position: relative; border-radius: 12px; overflow: hidden; touch-action: pinch-zoom; background: #fafafa; }
    .br-medidas__imagen img { display: block; width: 100%; height: auto; }
    .br-medidas__imagen span { position: absolute; right: 8px; bottom: 8px; background: rgb(0 0 0 / .65); color: #fff; font-size: 12px; padding: 4px 10px; border-radius: 999px; }
  </style>
{%- endif -%}
