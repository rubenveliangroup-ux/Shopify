{%- comment -%} BR · Colección destacada (tarjetas de br-product-card). {%- endcomment -%}
{{ 'br-landing.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign coll = s.collection | default: collections.all
-%}
<section class="br br-section">
  <div class="br-wrap">
    <div class="br-head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="br-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="br-h2">{{ s.heading }}</h2>
      </div>
      {%- if s.link_label != blank -%}<a class="br-link" href="{{ s.link | default: coll.url }}">{{ s.link_label }} →</a>{%- endif -%}
    </div>
    <ul class="br-grid br-grid--4" role="list">
      {%- for product in coll.products limit: s.limit -%}
        <li>{% render 'br-product-card', product: product %}</li>
      {%- else -%}
        <li><p class="br-ph">Elige una colección en el editor de temas.</p></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "BR · Colección destacada",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Colección" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Galicia, bordada" },
    { "type": "collection", "id": "collection", "label": "Colección", "info": "Vacío = todos los productos." },
    { "type": "range", "id": "limit", "label": "Productos", "min": 2, "max": 12, "step": 2, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todo" },
    { "type": "url", "id": "link", "label": "Enlace (vacío = la colección)" }
  ],
  "presets": [{ "name": "BR · Colección destacada" }]
}
{% endschema %}
