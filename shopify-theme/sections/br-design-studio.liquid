{%- comment -%}
  Estudio de diseño 3D de BR.
  El cliente crea su diseño, lo ve sobre la sudadera en 3D y lo añade al carrito
  con el diseño adjunto (propiedades de línea con archivos).
  Código fuente: repositorio rubenveliangroup-ux/Shopify, carpeta shopify-theme/.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign extra_product = section.settings.extra_product
  assign color_product = section.settings.color_product
  assign color_variant = color_product.selected_or_first_available_variant
  # Modelo 3D: URL del ajuste o, si está vacío, el primer modelo 3D (GLB) del producto.
  # Sin modelo, el estudio usa la sudadera 3D básica.
  assign model_url = section.settings.modelo_3d_url | strip
  if model_url == blank
    for media in product.media
      if media.media_type == 'model'
        for source in media.sources
          if source.format == 'glb'
            assign model_url = source.url
          endif
        endfor
        break
      endif
    endfor
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Pacifico&display=swap" rel="stylesheet">
{{ 'br-studio.css' | asset_url | stylesheet_tag }}

<div class="br-studio-section" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <script type="application/json" id="br-studio-config">
    {
      "price": {{ product.price | money | json }},
      "priceValue": {{ product.price | divided_by: 100.0 | json }},
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "colorMode": {{ section.settings.modo_color_prenda | json }},
      "stockColors": {{ section.settings.colores_stock | json }},
      "threadPaletteUrl": {{ 'br-hilos.json' | asset_url | json }},
      "modelUrl": {{ model_url | json }},
      "sizeChart": {% render 'br-medidas', formato: 'json' %},
      "embroidery": {
        "enabled": {{ section.settings.calc_enabled | json }},
        "puntadasPorCm2": {{ section.settings.puntadas_por_cm2 | json }},
        "puntadasPorCmBorde": {{ section.settings.puntadas_por_cm_borde | json }},
        "margenSeguridad": {{ section.settings.margen_seguridad | divided_by: 100.0 | json }},
        "costePorMil": {{ section.settings.coste_por_mil | json }},
        "multiplicadorMargen": {{ section.settings.multiplicador_margen | json }},
        "cuotaFija": {{ section.settings.cuota_fija | json }},
        "precioColorAdicional": {{ section.settings.precio_color_adicional | json }},
        "maxColores": {{ section.settings.max_colores | json }},
        "tramosTexto": {{ section.settings.tramos | json }},
        "tierVariants": [
          {%- for v in extra_product.variants -%}
            {"id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price | divided_by: 100.0 | json }}, "available": {{ v.available | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "colorVariant": {%- if color_variant -%}{"id": {{ color_variant.id }}, "title": {{ color_variant.title | json }}, "price": {{ color_variant.price | divided_by: 100.0 | json }}, "available": {{ color_variant.available | json }}}{%- else -%}null{%- endif -%}
      },
      "altHref": {{ section.settings.alt_link | default: '/pages/disenos-a-medida' | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {"id": {{ variant.id }}, "title": {{ variant.title | json }}, "available": {{ variant.available | json }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <div id="br-studio">
    <div style="min-height:60vh;display:grid;place-items:center;font-size:14px;opacity:.6">Preparando el estudio…</div>
  </div>
  <noscript><p style="text-align:center;padding:2rem">Activa JavaScript para usar el estudio de diseño.</p></noscript>
</div>

<script src="{{ 'br-studio.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Estudio de diseño BR",
  "tag": "section",
  "class": "section-br-studio",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto personalizable",
      "info": "Producto que se añade al carrito con el diseño (ej. Sudadera personalizada bordada)."
    },
    {
      "type": "url",
      "id": "alt_link",
      "label": "Enlace \"¿Prefieres que lo diseñemos nosotros?\""
    },
    { "type": "header", "content": "Modelo 3D" },
    { "type": "text", "id": "modelo_3d_url", "label": "URL del modelo 3D (.glb)", "info": "Sube el GLB optimizado en Contenido > Archivos y pega aquí su URL. Si lo dejas vacío se usa el modelo 3D del producto y, si no tiene, la sudadera básica. Requisitos: shopify-theme/MODELO-3D.md." },
    { "type": "header", "content": "Color de la prenda" },
    { "type": "select", "id": "modo_color_prenda", "label": "Modo de color de prenda (MODO_COLOR_PRENDA)", "options": [ { "value": "libre", "label": "Libre: cualquier color (sujeto a confirmación)" }, { "value": "stock", "label": "Stock: solo los colores de la lista" } ], "default": "libre" },
    { "type": "textarea", "id": "colores_stock", "label": "Colores de stock", "default": "Negro #1c1c1e\nCrudo #ece5d6\nGris jaspeado #9b9b9d\nAzul marino #1f2a44\nVerde bosque #2f4a3a\nArena #cdb898\nBurdeos #5b1f2b", "info": "Uno por línea: nombre y código hexadecimal. La carta de hilos se edita en assets/br-hilos.json." },
    { "type": "header", "content": "Calculadora de bordado" },
    { "type": "paragraph", "content": "Los precios que paga el cliente son los de las variantes de \"Extra de bordado\" y \"Color adicional de bordado\". Mantén estos ajustes iguales a esos precios: abre la página con ?calibrar=1 para comprobarlo." },
    { "type": "checkbox", "id": "calc_enabled", "label": "Activar calculadora de bordado", "default": true },
    { "type": "product", "id": "extra_product", "label": "Producto \"Extra de bordado\"", "info": "Una variante por tramo, en el mismo orden que los tramos." },
    { "type": "product", "id": "color_product", "label": "Producto \"Color adicional de bordado\"" },
    { "type": "number", "id": "puntadas_por_cm2", "label": "Puntadas por cm² (calibrar)", "default": 150 },
    { "type": "number", "id": "puntadas_por_cm_borde", "label": "Puntadas extra por cm de contorno", "default": 5 },
    { "type": "range", "id": "margen_seguridad", "label": "Margen de seguridad sobre puntadas", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 10 },
    { "type": "text", "id": "tramos", "label": "Topes de los tramos (puntadas)", "default": "5000, 10000, 15000, 20000", "info": "Por encima del último: diseño sujeto a presupuesto." },
    { "type": "text", "id": "coste_por_mil", "label": "Coste por 1.000 puntadas (€)", "default": "0,75" },
    { "type": "text", "id": "multiplicador_margen", "label": "Multiplicador de margen", "default": "1" },
    { "type": "text", "id": "cuota_fija", "label": "Cuota fija de montaje y digitalización (€)", "default": "5" },
    { "type": "text", "id": "precio_color_adicional", "label": "Precio por color adicional (€)", "default": "1" },
    { "type": "number", "id": "max_colores", "label": "Máximo de colores (agujas)", "default": 12 },
    { "type": "header", "content": "Márgenes" },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Estudio de diseño BR" }]
}
{% endschema %}
