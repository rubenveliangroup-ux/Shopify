{%- comment -%}
  Estudio de diseño 3D de BR.
  El cliente crea su diseño, lo ve sobre la sudadera en 3D y lo añade al carrito
  con el diseño adjunto (propiedades de línea con archivos).
  Código fuente: repositorio rubenveliangroup-ux/Shopify, carpeta shopify-theme/.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign extra_product = section.settings.extra_product
  assign color_product = section.settings.color_product
  assign color_variant = color_product.selected_or_first_available_variant
  # Modelo 3D: URL del ajuste o, si está vacío, assets/br-sudadera.glb (preparado con
  # tools/preparar-prenda.mjs). Si el 3D no es viable, el estudio usa la vista ligera (fotos).
  assign model_url = section.settings.modelo_3d_url | strip
  if model_url == blank
    assign model_url = 'br-sudadera.glb' | asset_url
  endif
  # Producto técnico oculto para subir archivos al CDN de Shopify («Enviar mi diseño»)
  assign upload_variant = all_products['br-subida-archivos'].selected_or_first_available_variant
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Pacifico&display=swap" rel="stylesheet">
{{ 'br-studio.css' | asset_url | stylesheet_tag }}
{{ 'br-opcion.css' | asset_url | stylesheet_tag }}

<div class="br-studio-section" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  {%- comment -%}
    «Enviar mi diseño»: formulario de contacto de Shopify que rellena el estudio (resumen + enlaces
    a los archivos) y envía. Llega al email de la tienda (Ajustes > Notificaciones > Email del remitente).
  {%- endcomment -%}
  {%- form 'contact', id: 'br-send-form', class: 'br-send-form' -%}
    {%- if form.posted_successfully? -%}
      {%- comment -%} Un solo formulario para «Enviar mi diseño» y «Te lo diseñamos nosotros»: el texto se elige al volver {%- endcomment -%}
      <div class="br-send-ok" id="br-send-ok" role="status" tabindex="-1">
        <strong data-msg-diseno="¡Diseño enviado!" data-msg-encargo="¡Solicitud recibida!">¡Recibido!</strong>
        <span
          data-msg-diseno="Lo hemos recibido con tu resumen y la vista previa. Te escribiremos a tu email con el boceto y el precio, normalmente en 24-48 h laborables. Si quieres añadir algo, responde a nuestro email."
          data-msg-encargo="Hemos recibido tu solicitud, te contactaremos para darte un presupuesto. Si quieres añadir algo, responde a nuestro email."
        >Te escribiremos a tu email muy pronto. Si quieres añadir algo, responde a nuestro email.</span>
      </div>
      <script>
        (function () {
          var k; try { k = sessionStorage.getItem('br-envio'); sessionStorage.removeItem('br-envio'); } catch (e) {}
          var box = document.getElementById('br-send-ok');
          if (!box) return;
          if (k === 'diseno' || k === 'encargo') box.querySelectorAll('[data-msg-' + k + ']').forEach(function (n) { n.textContent = n.getAttribute('data-msg-' + k); });
          box.scrollIntoView({ block: 'center' }); box.focus({ preventScroll: true });
        })();
      </script>
    {%- elsif form.errors -%}
      <div class="br-send-err" role="alert">No se pudo enviar el diseño: {{ form.errors | default_errors }}</div>
    {%- endif -%}
    <input type="hidden" name="contact[Origen]" value="Diseña tu prenda">
  {%- endform -%}
  <style>
    .br-send-form { max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
    .br-send-ok, .br-send-err { display: grid; gap: 4px; margin: 0 0 16px; padding: 16px 18px; border-radius: 16px; font-size: 15px; line-height: 1.45; }
    .br-send-ok { background: #e4efe6; color: #1f4a2c; }
    .br-send-err { background: #f6e1df; color: #7a1f2b; }
  </style>
  <script type="application/json" id="br-studio-config">
    {
      "price": {{ product.price | money | json }},
      "priceValue": {{ product.price | divided_by: 100.0 | json }},
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "colorMode": {{ section.settings.modo_color_prenda | json }},
      "stockColors": {{ section.settings.colores_stock | json }},
      "threadPaletteUrl": {{ 'br-hilos.json' | asset_url | json }},
      "workerUrl": {{ 'br-bordado-worker.js' | asset_url | json }},
      "send": { "formId": "br-send-form", "uploadVariantId": {{ upload_variant.id | default: 'null' }}, "root": {{ routes.root_url | json }} },
      "modelUrl": {{ model_url | json }},
      "liteImages": { "delante": {{ 'br-prenda-delante.webp' | asset_url | json }}, "detras": {{ 'br-prenda-detras.webp' | asset_url | json }} },
      "sizeChart": {% render 'br-medidas', formato: 'json' %},
      "embroidery": {
        "enabled": {{ section.settings.calc_enabled | json }},
        "puntadasPorCm2": {{ section.settings.puntadas_por_cm2 | json }},
        "puntadasPorCmLinea": {{ section.settings.puntadas_por_cm_linea | json }},
        "puntadasPorCmBorde": {{ section.settings.puntadas_por_cm_borde | json }},
        "anchoMaxLineaMm": {{ section.settings.ancho_max_linea_mm | json }},
        "margenSeguridad": {{ section.settings.margen_seguridad | divided_by: 100.0 | json }},
        "margenError": {{ section.settings.margen_error | divided_by: 100.0 | json }},
        "umbralPresupuesto": {{ section.settings.umbral_presupuesto | json }},
        "bastidorAnchoCm": {{ section.settings.bastidor_ancho | json }},
        "bastidorAltoCm": {{ section.settings.bastidor_alto | json }},
        "costePorMil": {{ section.settings.coste_por_mil | json }},
        "multiplicadorMargen": {{ section.settings.multiplicador_margen | json }},
        "cuotaFija": {{ section.settings.cuota_fija | json }},
        "precioColorAdicional": {{ section.settings.precio_color_adicional | json }},
        "maxColores": {{ section.settings.max_colores | json }},
        "tramosTexto": {{ section.settings.tramos | json }},
        "tierVariants": [
          {%- for v in extra_product.variants -%}
            {"id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price | divided_by: 100.0 | json }}, "available": {{ v.available | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "colorVariant": {%- if color_variant -%}{"id": {{ color_variant.id }}, "title": {{ color_variant.title | json }}, "price": {{ color_variant.price | divided_by: 100.0 | json }}, "available": {{ color_variant.available | json }}}{%- else -%}null{%- endif -%}
      },
      "altHref": {{ section.settings.alt_link | default: '/pages/disenos-a-medida' | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {"id": {{ variant.id }}, "title": {{ variant.title | json }}, "available": {{ variant.available | json }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <div id="br-studio">
    <div style="min-height:60vh;display:grid;place-items:center;align-content:center;gap:16px;font-size:14px;color:rgba(27,26,23,.6)">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 240 | image_tag: loading: 'eager', alt: shop.name, style: 'width:120px;height:auto;opacity:.85' }}
      {%- endif -%}
      Preparando el estudio…
    </div>
  </div>
  <noscript><p style="text-align:center;padding:2rem">Activa JavaScript para usar el estudio de diseño.</p></noscript>
</div>

{%- comment -%} Módulo ES: el visor 3D (three.js) es un chunk aparte que se pide después de cargar la página {%- endcomment -%}
<script type="module" src="{{ 'br-studio.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Estudio de diseño BR",
  "tag": "section",
  "class": "section-br-studio",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto personalizable",
      "info": "Producto que se añade al carrito con el diseño (ej. Sudadera personalizada bordada)."
    },
    {
      "type": "url",
      "id": "alt_link",
      "label": "Enlace \"¿Prefieres que lo diseñemos nosotros?\""
    },
    { "type": "header", "content": "Modelo 3D" },
    { "type": "text", "id": "modelo_3d_url", "label": "URL de otro modelo 3D (.glb)", "info": "Vacío = la sudadera del tema (assets/br-sudadera.glb). Para cambiarla, prepara el GLB como explica shopify-theme/MODELO-3D.md." },
    { "type": "header", "content": "Color de la prenda" },
    { "type": "select", "id": "modo_color_prenda", "label": "Modo de color de prenda (MODO_COLOR_PRENDA)", "options": [ { "value": "libre", "label": "Libre: cualquier color (sujeto a confirmación)" }, { "value": "stock", "label": "Stock: solo los colores de la lista" } ], "default": "libre" },
    { "type": "textarea", "id": "colores_stock", "label": "Colores de stock", "default": "Negro #1c1c1e\nCrudo #ece5d6\nGris jaspeado #9b9b9d\nAzul marino #1f2a44\nVerde bosque #2f4a3a\nArena #cdb898\nBurdeos #5b1f2b", "info": "Uno por línea: nombre y código hexadecimal. La carta de hilos se edita en assets/br-hilos.json." },
    { "type": "header", "content": "Calculadora de bordado" },
    { "type": "paragraph", "content": "Los precios que paga el cliente son los de las variantes de \"Extra de bordado\" y \"Color adicional de bordado\". Mantén estos ajustes iguales a esos precios: abre la página con ?calibrar=1 para comprobarlo." },
    { "type": "checkbox", "id": "calc_enabled", "label": "Activar calculadora de bordado", "default": true },
    { "type": "product", "id": "extra_product", "label": "Producto \"Extra de bordado\"", "info": "Una variante por tramo, en el mismo orden que los tramos." },
    { "type": "product", "id": "color_product", "label": "Producto \"Color adicional de bordado\"" },
    { "type": "number", "id": "puntadas_por_cm2", "label": "PUNTADAS_POR_CM2: puntadas por cm² de relleno (calibrar)", "default": 150 },
    { "type": "number", "id": "puntadas_por_cm_linea", "label": "PUNTADAS_POR_CM_LINEA: puntadas por cm de línea (calibrar)", "default": 25, "info": "Trazos más estrechos que el ancho máximo de línea (satén)." },
    { "type": "number", "id": "puntadas_por_cm_borde", "label": "Puntadas extra por cm de borde de los rellenos", "default": 5 },
    { "type": "number", "id": "ancho_max_linea_mm", "label": "Ancho máximo de línea (mm)", "default": 4, "info": "Más estrecho: línea en satén. Más ancho: relleno." },
    { "type": "range", "id": "margen_seguridad", "label": "Margen de seguridad sobre puntadas", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 10 },
    { "type": "range", "id": "margen_error", "label": "MARGEN_ERROR: amplitud del rango mostrado", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 20 },
    { "type": "number", "id": "umbral_presupuesto", "label": "Puntadas a partir de las que se pide presupuesto", "default": 50000 },
    { "type": "number", "id": "bastidor_ancho", "label": "Área máxima de bordado: ancho (cm)", "default": 30 },
    { "type": "number", "id": "bastidor_alto", "label": "Área máxima de bordado: alto (cm)", "default": 30 },
    { "type": "text", "id": "tramos", "label": "Topes de los tramos (puntadas)", "default": "5000, 10000, 15000, 20000, 30000, 40000, 50000", "info": "Una variante de «Extra de bordado» por tramo. Por encima del último (o del umbral): presupuesto." },
    { "type": "text", "id": "coste_por_mil", "label": "Coste por 1.000 puntadas (€)", "default": "0,75" },
    { "type": "text", "id": "multiplicador_margen", "label": "Multiplicador de margen", "default": "1" },
    { "type": "text", "id": "cuota_fija", "label": "Cuota fija de montaje y digitalización (€)", "default": "5" },
    { "type": "text", "id": "precio_color_adicional", "label": "Precio por color adicional (€)", "default": "1" },
    { "type": "number", "id": "max_colores", "label": "Máximo de colores (agujas)", "default": 12 },
    { "type": "header", "content": "Márgenes" },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Estudio de diseño BR" }]
}
{% endschema %}
