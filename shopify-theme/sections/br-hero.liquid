{%- comment -%}
  BR · Hero de portada a pantalla completa: foto o vídeo, titular corto, frase y tres botones
  (el tercero, «Impulsa tu marca», con el estilo destacado de la marca).

  Vídeo: <video autoplay muted loop playsinline> con sus fuentes en el HTML (no depende de JavaScript):
  hero-escritorio.mp4 en pantallas grandes y en horizontal, hero-movil.mp4 en móvil en vertical, y
  hero-poster.jpg como imagen de respaldo (se pinta al instante y queda si el vídeo no se reproduce).
  Con «reducir movimiento» se ve solo la imagen. data-estado en el <video> dice qué pasa:
  reproduciendo · cargando · reducir-movimiento · ahorro-de-datos · bloqueado (el navegador no deja
  reproducir solo, p. ej. iPhone en bajo consumo) · error (no se pudo descargar o leer el archivo).
  Si «Usar el vídeo optimizado del tema» está desactivado, se usa el vídeo subido en «Vídeo».
{%- endcomment -%}
{{ 'br-landing.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign overlay = s.overlay | divided_by: 100.0

  # Fuentes del vídeo y de la imagen de respaldo
  assign v_escritorio = ''
  assign v_movil = ''
  assign poster = ''
  if s.media == 'video'
    if s.video_optimizado
      assign v_escritorio = 'hero-escritorio.mp4' | asset_url
      assign v_movil = 'hero-movil.mp4' | asset_url
      assign poster = 'hero-poster.jpg' | asset_url
    elsif s.video != blank
      assign h_escritorio = 0
      assign h_movil = 100000
      for src in s.video.sources
        if src.format == 'mp4'
          if src.height > h_escritorio and src.height <= 720
            assign h_escritorio = src.height
            assign v_escritorio = src.url
          endif
          if src.height < h_movil
            assign h_movil = src.height
            assign v_movil = src.url
          endif
        endif
      endfor
      if v_escritorio == blank
        assign v_escritorio = v_movil
      endif
      assign poster = s.video.preview_image | image_url: width: 1920
    endif
    if s.poster != blank
      assign poster = s.poster | image_url: width: 1920
    endif
  endif
-%}
<section class="br br-hero" style="--br-overlay: {{ overlay }};" aria-label="{{ s.heading | strip_html | escape }}">
  <div class="br-hero__media">
    {%- if v_escritorio != blank -%}
      <img class="br-hero__poster" src="{{ poster }}" alt="" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async">
      <video
        id="BrHeroVideo-{{ section.id }}"
        class="br-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="{{ poster }}"
        disablepictureinpicture
        disableremoteplayback
        aria-hidden="true"
        tabindex="-1"
        data-estado="cargando"
      >
        {%- comment -%} El navegador usa la primera que encaje; el que no entienda «media» usa la de escritorio. {%- endcomment -%}
        <source src="{{ v_escritorio }}" type="video/mp4" media="(min-width: 750px), (orientation: landscape)">
        <source src="{{ v_movil | default: v_escritorio }}" type="video/mp4">
      </video>
      <script>
        (function () {
          var v = document.getElementById('BrHeroVideo-{{ section.id }}');
          if (!v) return;
          var reducir = window.matchMedia('(prefers-reduced-motion: reduce)');
          var c = navigator.connection;
          function parar(estado) {
            v.removeAttribute('autoplay');
            v.preload = 'none';
            v.pause();
            v.dataset.estado = estado;
          }
          // Movimiento reducido o ahorro de datos: solo la imagen de respaldo
          if (reducir.matches) return parar('reducir-movimiento');
          if (c && c.saveData) return parar('ahorro-de-datos');
          v.muted = true; // como propiedad además de atributo: algunos navegadores solo miran esta para dejar reproducir solo
          v.addEventListener('playing', function () { v.dataset.estado = 'reproduciendo'; });
          v.addEventListener('error', function () { v.dataset.estado = 'error'; }, true);
          var p = v.play();
          if (p && p.catch) p.catch(function (e) {
            if (v.dataset.estado !== 'reproduciendo') v.dataset.estado = e && e.name === 'NotAllowedError' ? 'bloqueado' : 'error';
          });
          if (reducir.addEventListener) reducir.addEventListener('change', function (e) {
            if (e.matches) parar('reducir-movimiento');
          });
        })();
      </script>
    {%- else -%}
      {%- if s.image_mobile != blank -%}
        {{ s.image_mobile | image_url: width: 1200 | image_tag: class: 'br-hero__img--mobile', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '100vw', alt: s.image_mobile.alt }}
      {%- endif -%}
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 2400 | image_tag: class: 'br-hero__img--desktop', loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: s.image.alt }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'br-hero__ph' }}
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="br-wrap br-hero__inner">
    {%- if s.show_logo and settings.logo_inverse != blank -%}
      {{ settings.logo_inverse | image_url: width: 600 | image_tag: class: 'br-hero__logo', loading: 'eager', alt: shop.name }}
    {%- endif -%}
    {%- if s.eyebrow != blank -%}<p class="br-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="br-h1">{{ s.heading }}</h1>
    {%- if s.text != blank -%}<p class="br-lead">{{ s.text }}</p>{%- endif -%}
    <div class="br-btns br-btns--hero">
      {%- if s.button_1_label != blank -%}<a class="br-btn br-btn--light" href="{{ s.button_1_link | default: routes.all_products_collection_url }}">{{ s.button_1_label }}</a>{%- endif -%}
      {%- if s.button_2_label != blank -%}<a class="br-btn br-btn--line-light" href="{{ s.button_2_link | default: '/pages/disena-tu-prenda' }}">{{ s.button_2_label }}</a>{%- endif -%}
      {%- if s.button_3_label != blank -%}<a class="br-btn br-btn--brand" href="{{ s.button_3_link | default: '/pages/impulsa-tu-marca' }}">{% render 'br-estrella' %}{{ s.button_3_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BR · Hero",
  "tag": "div",
  "class": "section-br-hero",
  "settings": [
    { "type": "select", "id": "media", "label": "Fondo", "options": [{ "value": "video", "label": "Vídeo" }, { "value": "image", "label": "Imagen" }], "default": "video" },
    { "type": "checkbox", "id": "video_optimizado", "label": "Usar el vídeo optimizado del tema", "info": "assets/hero-escritorio.mp4, hero-movil.mp4 y hero-poster.jpg. Si está desactivado, se usa el vídeo de abajo.", "default": false },
    { "type": "video", "id": "video", "label": "Vídeo (sin sonido, en bucle)", "info": "Si no hay vídeo se usa la imagen." },
    { "type": "image_picker", "id": "poster", "label": "Imagen de respaldo del vídeo (opcional)", "info": "Sustituye a hero-poster.jpg: se ve al instante mientras carga y si el vídeo no se reproduce." },
    { "type": "image_picker", "id": "image", "label": "Imagen (escritorio)", "info": "Horizontal, mínimo 2000 px de ancho." },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen para móvil (opcional)", "info": "Vertical 4:5 o 9:16. Si no hay, se recorta la de escritorio." },
    { "type": "range", "id": "overlay", "label": "Oscurecer la imagen", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "checkbox", "id": "show_logo", "label": "Mostrar el logo (versión clara del tema)", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Bordado en Galicia" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Tu idea, bordada." },
    { "type": "text", "id": "text", "label": "Frase de apoyo", "default": "Sudaderas bordadas en Pontevedra. Elige un diseño de la colección o crea el tuyo y míralo en 3D antes de pedirlo." },
    { "type": "text", "id": "button_1_label", "label": "Botón 1", "default": "Ver catálogo" },
    { "type": "url", "id": "button_1_link", "label": "Enlace del botón 1" },
    { "type": "text", "id": "button_2_label", "label": "Botón 2", "default": "Diseña tu prenda" },
    { "type": "url", "id": "button_2_link", "label": "Enlace del botón 2" },
    { "type": "text", "id": "button_3_label", "label": "Botón 3 (destacado)", "default": "Impulsa tu marca" },
    { "type": "url", "id": "button_3_link", "label": "Enlace del botón 3" }
  ],
  "presets": [{ "name": "BR · Hero" }]
}
{% endschema %}
