{%- comment -%} BR · Impulsa tu marca (empresas y merch) con botón al formulario. {%- endcomment -%}
{{ 'br-landing.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="br br-section br-cta">
  <div class="br-wrap br-cta__grid">
    <div>
      {%- if s.eyebrow != blank -%}<p class="br-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="br-h2">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="br-lead">{{ s.text }}</p>{%- endif -%}
      {%- assign puntos = s.points | newline_to_br | split: '<br />' -%}
      {%- if s.points != blank -%}
        <ul class="br-cta__list">{%- for p in puntos -%}{%- assign p = p | strip -%}{%- if p != blank -%}<li>{{ p }}</li>{%- endif -%}{%- endfor -%}</ul>
      {%- endif -%}
      <div class="br-btns"><a class="br-btn br-btn--brand" href="{{ s.button_link | default: '/pages/impulsa-tu-marca#contacto' }}">{% render 'br-estrella' %}{{ s.button_label }}</a></div>
    </div>
    {%- if s.image != blank -%}
      <div class="br-cta__media">{{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 990px) 40vw, 100vw', alt: s.image.alt }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BR · Impulsa tu marca",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Empresas y merch" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Impulsa tu marca con bordado" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Bordamos tu logo en prendas para equipos, eventos y tiendas. Nos traes la prenda y el diseño, o lo preparamos nosotros. Sin cantidad mínima." },
    { "type": "textarea", "id": "points", "label": "Puntos (uno por línea)", "default": "Diseño del logo o adaptación a bordado\nTu prenda o la nuestra\nPresupuesto sin compromiso" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Cuéntanos tu proyecto" },
    { "type": "url", "id": "button_link", "label": "Enlace (vacío = formulario de Impulsa tu marca)" },
    { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" }
  ],
  "presets": [{ "name": "BR · Impulsa tu marca" }]
}
{% endschema %}
